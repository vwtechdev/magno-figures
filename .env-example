# Projeto / domínio
COMPOSE_PROJECT_NAME=
DOMAIN=

# Django
SECRET_KEY=
DEBUG=0
DJANGO_ALLOWED_HOSTS=

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# SuperFrete
SUPERFRETE_TOKEN=
SUPERFRETE_SANDBOX=1
SUPERFRETE_USER_AGENT_EMAIL=example@example.com
SUPERFRETE_SERVICES=1,2

# reCAPTCHA v3 (Google)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_TIMEOUT=10

# SMTP (Google Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=15
EMAIL_MAX_WORKERS=2
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_DELAY=1.0
DEFAULT_FROM_EMAIL=
